# 모두 선택 사항입니다. 아무것도 설정하지 않아도 앱은 동작합니다.

# 앱 접근 비밀번호. 비워두면 로그인 화면 없이 바로 열립니다 (로컬 단독 사용 시 권장).
ADMIN_PASSWORD=

# API 키 암호화용 32바이트 마스터 키(base64).
# 지정하지 않으면 최초 실행 시 data/.master_key 에 자동 생성됩니다(권한 0600).
# data/ 디렉터리를 백업/동기화한다면, 키는 이렇게 바깥으로 빼두세요:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY_BASE64=

# DB와 사진 저장 위치. 기본값은 프로젝트 내 data/ 입니다.
OSMU_DATA_DIR=

# LLM API 키는 여기 두지 않습니다 — 앱의 ⚙️ 설정 페이지에서 입력하면
# AES-256-GCM으로 암호화되어 SQLite에 저장됩니다.
